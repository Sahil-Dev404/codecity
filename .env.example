# ─────────────────────────────────────────────────────────────
# CodeCity environment template.
# Copy to `.env` and adjust:   copy .env.example .env
# Never commit the real .env (it is git-ignored).
# Put comments on their own lines; some parsers break on inline ones.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_USER=codecity
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codecity
DATABASE_URL=postgresql+asyncpg://codecity:change-me@localhost:5432/codecity

# ── Redis (job queue + cache) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# ── Safety limits for analyzing untrusted repos ──────────────
# Only these git hosts may be cloned (comma-separated). Blocks SSRF.
ALLOWED_GIT_HOSTS=github.com
MAX_REPO_SIZE_MB=500
MAX_COMMITS=5000
HISTORY_YEARS=3
CLONE_TIMEOUT_SECONDS=120
ANALYSIS_TIMEOUT_SECONDS=600
RATE_LIMIT_PER_MINUTE=10

# ── Paths ────────────────────────────────────────────────────
DATA_DIR=./data
MODEL_PATH=./ml/artifacts/model.onnx

# ── Optional integrations ────────────────────────────────────
# GitHub token raises API rate limits (leave empty if unused)
GITHUB_TOKEN=
# Experiment tracking. "disabled" means no account needed.
WANDB_MODE=disabled
WANDB_API_KEY=

# ── Frontend (Next.js) ───────────────────────────────────────
# NEXT_PUBLIC_ variables are exposed to the browser. Never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000